{
  "name": "human-messenger",
  "version": "1.0.0",
  "description": "Мессенджер для людей на Electron и Supabase",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "start-server": "node server.js",
    "start-electron": "electron .",
    "build-win": "electron-builder --win"
  },

  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "cookie-session": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.humanmessenger.app",
    "productName": "HumanMessenger",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
